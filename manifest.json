{
  "manifest_version": 3,
  "name": "Anki 编辑器",
  "version": "2.1",
  "description": "Ankiweb卡片编辑器",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://ankiuser.net/*"],
  "action": {
    "default_title": "Anki 编辑器工具栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ankiuser.net/add*", "https://ankiuser.net/edit*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
